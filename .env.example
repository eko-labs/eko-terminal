# ─────────────────────────────────────────────────────────────────────────────
# EKO environment template. Copy to apps/server/.env (or set in your host).
# Every variable is optional for local development: with none set, EKO runs
# on embedded PGlite + deterministic simulated data.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development            # development | test | production
PORT=8710
HOST=0.0.0.0
# API and MCP: non-negative integer; 0 uses the socket peer and ignores forwarded addresses.
# Set only for a fixed, restricted proxy path. Railway's edge appends one hop: staging uses 1.
# With a positive value, block direct origin access and any path with fewer trusted hops.
TRUST_PROXY_HOPS=0
# TODO(spec): bounded public WebSocket defaults; window and snapshot limits are per API process.
WS_WINDOW_MS=1000
WS_MESSAGES_PER_WINDOW=30
WS_HARD_MESSAGES_PER_WINDOW=90
WS_SNAPSHOTS_PER_CONNECTION=2
WS_SNAPSHOTS_GLOBAL=16
WS_SNAPSHOT_QUEUE=128
# Origin(s) of the web app, comma-separated. Used for CORS and as the SIWE domain (the nonce
# endpoint names the origin the request came from). Must be the public https origin in production
# when LIVE_TRADING_ENABLED=true (boot refuses localhost).
PUBLIC_ORIGIN=http://localhost:5180
# Optional deployment bot identifier, without @. No Telegram transport is enabled here.
TELEGRAM_BOT_HANDLE=
# Optional shared app/api/mcp cookie domain; inferred from PUBLIC_ORIGIN when unset.
SESSION_COOKIE_DOMAIN=
# TODO(spec): launch-week agent quota is unset; 0 means unavailable, never unlimited.
LAUNCH_WEEK_AGENT_LIMIT=
# EKO Points: disabled until the T instant and launch rates/caps are decided.
# Rates JSON keys: guarded_volume, shared_journal, opened_scan, ghost_tip.
# Each configured category requires pointsPerUnit and dailyCapPoints (integers).
POINTS_ACTIVE_FROM=
POINTS_RATES={}
# REQUIRED in production (≥ 32 chars). Signs session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=
HARNESS_KEY_PEPPER=
# Public MCP endpoint (HTTPS, path /mcp). The MCP role requires it; the API fills it into the
# GET /v1/packs setup templates (unset leaves {{MCP_URL}}). Set the same value on both.
# Hosted connector stays unavailable until task 099 real-connector acceptance; Claude Code uses API keys.
MCP_PUBLIC_URL=https://mcp.eko.example/mcp
MCP_OAUTH_ENABLED=false
OAUTH_ISSUER=https://mcp.eko.example
OAUTH_REDIRECT_ALLOWLIST=["https://claude.ai/api/mcp/auth_callback"]
OAUTH_ACCESS_TTL_S=3600
OAUTH_REFRESH_TTL_S=2592000
OAUTH_CODE_TTL_S=60
# 32-byte hex host-secret KEK; never stored in Postgres.
JOURNAL_KEK=
JOURNAL_KEK_ID=
# Current append-only destruction ledger, provisioned outside database backups.
JOURNAL_TOMBSTONE_PATH=
# Serve the built web app (apps/web/dist) from the API server (single-service deploy).
SERVE_WEB=false
WEB_DIST_DIR=../web/dist
# Run the signal worker, order reconciler and evaluation jobs here. Exactly ONE process should.
RUN_WORKER=true
# Worker only. Treasury's SDN XML (redirects to the Sanctions List Service and its signed
# download link; the downloader follows those Treasury hops only):
# https://sanctionslistservice.ofac.treas.gov/api/publicationpreview/exports/sdn.xml
# Absent usable snapshot refuses executable quotes and orders; refresh failures retain the last complete snapshot.
OFAC_SDN_URL=
LOG_LEVEL=info
# Optional error reporting (Sentry envelope API, no SDK needed).
SENTRY_DSN=

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string for production.
# Leave empty to use embedded PGlite on disk at PGLITE_DIR (dev/demo only).
DATABASE_URL=
PGLITE_DIR=.data/pglite

# ── v1 foundation ──────────────────────────────────────────────────────────
# Comma-separated product flags or d0; unknown names and ops switches refuse boot.
FLAGS=
# REQUIRED in production (≥32 chars). HMAC key for 24-hour demo tokens.
DEMO_SECRET=
# Temporary compatibility for existing product routes; signals/bots need both switches.
LEGACY_API=true
LEGACY_SIGNALS=false
# ISO-8601 deployment times. Empty keeps the pre-token/pre-tier phase.
FEE_ACTIVE_FROM=
TIERS_ACTIVE_FROM=
FEE_BPS_DEFAULT=50
# Optional absolute ceiling over the role/public schedule. Set 250 to hold the lower T cap.
TRADE_MAX_USD=
# Empty uses the shipped config/trading-caps.yaml. File changes require a config release.
TRADE_CAPS_FILE=
# Set to the approved T instant; unset public trading has a zero cap.
TRADE_CAPS_FROM=
# Release action at T: set false to open public access (time alone does not lift this gate).
TRADING_ALLOWLIST_ONLY=true
# Deployment address placeholders; configure before enabling execution.
BURN_WALLET_ADDRESS=
RECEIPTS_REGISTRY_ADDRESS=
# Public disclosure only; never a fee or burn destination.
DEV_FEE_WALLET=

# ── Market data ──────────────────────────────────────────────────────────────
# onchain = indexed swaps (not implemented yet; boot fails with a clear error)
# demo    = deterministic simulator, clearly labelled "Simulated data" in the UI
# Default is demo outside production; production defaults to onchain and refuses boot for now.
MARKET_DATA_SOURCE=demo
DEMO_SEED=42

# ── Robinhood Chain ─────────────────────────────────────────────────────────
# Empty = the official public RPCs (mainnet https://rpc.mainnet.chain.robinhood.com). They are
# rate-limited and "not recommended for production" (Robinhood docs).
# Use a listed provider (e.g. Alchemy: https://robinhood-mainnet.g.alchemy.com/v2/<KEY>).
RH_MAINNET_RPC_URL=
RH_TESTNET_RPC_URL=
# Live (mainnet) execution stays disabled unless this is exactly "true".
LIVE_TRADING_ENABLED=false
# Private simulation host for live trades: an Anvil started with its own --fork-url to an archive upstream. The api and
# worker reset it to each order's block and run the trader's exact transaction there before returning bytes or
# confirming a buy. Empty = live quotes refuse. Give every api replica and the worker its own host (resets are exclusive
# per process). Live quotes also need RH_MAINNET_RPC_URL/RPC_HTTP_URL: they read state at a pinned block.
ANVIL_FORK_URL=
# Live sell check (eth_call probe with a state override; no Anvil). Set on engines AND api together: engines measure
# exit cost for Radar and coin pages, the api re-checks every buy quote and refuses a coin whose sell fails.
# SELL_CHECK_DAILY_REQUESTS caps the engines' paid requests for it per UTC day (default 60000).
SELL_CHECK_ENABLED=false
SELL_CHECK_DAILY_REQUESTS=
# Cooldowns survive restarts; a changed route/pool or a price crash can make a check due sooner.
SELL_CHECK_UNSUPPORTED_DAYS=7
# Consecutive failed buys double this delay, capped at seven days.
SELL_CHECK_BUY_FAILED_HOURS=24
SELL_CHECK_SELLABLE_HOURS=24
# Only first checks of live-listed coins and crash rechecks may spend the last reserved requests.
SELL_CHECK_RESERVE_PCT=20
# Comma-separated wallet addresses allowed to moderate community bot submissions.
ADMIN_WALLETS=

# ── AI gateway (recommended: one key powers every AI analyst) ────────────────
# `pnpm setup:ai` prompts for a PPQ.ai key (hidden input), verifies it without spending
# anything and writes these two lines to apps/server/.env (mode 0600). Every provider below
# that has no direct key is then served through the gateway's /v1/chat/completions.
GATEWAY_BASE_URL=https://api.ppq.ai
GATEWAY_API_KEY=
# Optional per-provider model overrides when served through the gateway (defaults shown).
GATEWAY_MODEL_ANTHROPIC=claude-sonnet-5
GATEWAY_MODEL_OPENAI=gpt-5.6-sol
GATEWAY_MODEL_GOOGLE=google/gemini-3.8-flash
GATEWAY_MODEL_XAI=grok-4.6
GATEWAY_MODEL_DEEPSEEK=deepseek/deepseek-v4.1-flash
GATEWAY_MODEL_MISTRAL=mistralai/mistral-small-2603
GATEWAY_MODEL_GROQ=openai/gpt-oss-120b

# ── AI providers, direct (server-side only; a direct key takes precedence over the gateway) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
XAI_API_KEY=
XAI_MODEL=grok-4.3
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-2603
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
# Hard ceiling on estimated AI spend per UTC day across all providers (0 disables AI).
AI_DAILY_BUDGET_USD=0
# Hard ceiling on model calls per bot per hour.
AI_MAX_CALLS_PER_BOT_HOUR=12
AI_TIMEOUT_MS=25000

# ── Development / tests only (refused in production) ────────────────────────
ENABLE_DEV_ROUTES=false

# ── Web app (Vite, build-time; prefix VITE_) ────────────────────────────────
# API base defaults to same-origin /v1. VITE_API_BASE is a compatible alias.
VITE_API_URL=/v1
VITE_WS_URL=
# Offline REST + channel fixtures; no server required. Set in apps/web/.env.local or the shell.
VITE_MOCKS=0
# Wallet and receipt reads use the keyless VITE_API_URL/rpc endpoint.
# Never put a provider URL or key in browser build variables. Testnet is dev-only.

# Optional explicit coin identity for burn flames (never inferred from a ticker).
VITE_EKO_TOKEN_ADDRESS=

# Shared RPC spending guard; paid HTTP/WS endpoints come only from deployment secrets.
# RPC_HTTP_URL=
# RPC_WS_URL=
RPC_PUBLIC_HTTP_URL=https://rpc.mainnet.chain.robinhood.com
RPC_PAID_MAX_RPM=600
RPC_PUBLIC_MAX_RPM=120
# Paid call ceiling for application roles; defaults to soft limit plus the indexer reserve.
RPC_PAID_DAILY_BUDGET=800000
RPC_PAID_DAILY_SOFT_LIMIT=500000
RPC_PAID_INDEXER_RESERVE=300000
# RPC_SESSION_BUDGET=100
# Long-lived indexer/engines provider-outage probe backoff: 10 seconds up to this cap.
RPC_OUTAGE_MAX_BACKOFF_SEC=300
RPC_WEIGHTS={}
# Standalone chain CLI persistence (PGlite, single process) when DATABASE_URL is unset.
RPC_USAGE_DIR=.data/rpc-usage

# Receipts role: provide exactly one gas-only committer secret through the host secret store.
RECEIPTS_COMMITTER_KEY=
# Mounted secret file is re-read for each fresh attempt after rotation.
RECEIPTS_COMMITTER_KEY_FILE=

# Read-only security collectors in APP_ROLE=worker; all disabled until owner provisioning.
# See infra/monitoring/README.md for accepted registry, start blocks, thresholds and intents.
SECURITY_COLLECTORS={}

# Swarm inference stays disabled until an operator verifies both catalogues and cost ceilings.
SWARM_ENABLED=false
SWARM_DAILY_BUDGET_USD=0
SWARM_PER_COIN_BUDGET_USD=0.25
# JSON: version, verified:true, luna/sol/opus each with openrouter:{model,maxUsd}
# and ppq:{provider,model,maxUsd}. No model slug defaults are assumed.
SWARM_MODELS=

# Determination retention (worker). Default deploy only reports, it changes no rows.
RETENTION_ENABLED=true
RETENTION_DRY_RUN=true
RETENTION_SETTLE_HOURS=24
DAYS_AHEAD=3
# Maximum seconds per raw-history seal statement; interrupted batches resume.
RAW_SEAL_STATEMENT_SEC=300
RETENTION_SWAP_DAYS=1
RETENTION_TRANSFER_DAYS=1
FINGERPRINT_LOOKBACK_DAYS=1
FINGERPRINT_REFRESH_DAYS=1
# Latest liquidity price keys per SQL statement (1-1000)
READ_LIQUIDITY_PROBE_KEYS=100
# Determination horizon for liquidity and Pons events; raw swaps/transfers use their own caps.
RETENTION_RAW_DAYS=1
RETENTION_RATING_DAYS=1
RETENTION_FEED_DAYS=1
RETENTION_PENDING_POOL_DAYS=1
# All verdict receipt payloads, including the current card receipt.
RETENTION_RECEIPT_HOURS=24
# Opt in to retaining the current card receipt payload beyond the window.
RETENTION_RECEIPT_KEEP_CURRENT=false

# Optional category. Floors are provisional pending the production report.
BLUE_CHIP_ENABLED=false
BLUE_CHIP_MIN_AGE_DAYS=3
BLUE_CHIP_MIN_LIQUIDITY_USD=25000
BLUE_CHIP_MIN_HOLDERS=250

# Pause fingerprint and flow refreshes without a code deploy (restart engines after changing).
# Pause before migration 0206, run scripts/backfill-watcher-buyers.sql, then enable.
ENGINE_WATCHER_REFRESH_ENABLED=true
