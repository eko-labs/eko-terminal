# syntax=docker/dockerfile:1.7
# EKO on Elysium: one small stateless service (apps/edge) that serves the terminal, the landing site and the read API.
# No database, no signing keys. Secrets it may read at runtime: RPC_HTTP_URL (a read-only RPC key) and nothing else.

FROM node:22.23.4-bookworm-slim@sha256:5991875dfb80938dd8a6ba3fe3e96fd04929e70792762b3319d8caadbbe229bc AS base
RUN corepack enable && corepack prepare pnpm@11.5.1 --activate
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
# Every workspace manifest, so the frozen lockfile matches the workspace it was written for.
COPY packages/shared/package.json packages/shared/
COPY packages/receipts-verifier/package.json packages/receipts-verifier/
COPY packages/chain/package.json packages/chain/
COPY packages/db/package.json packages/db/
COPY packages/playbooks/package.json packages/playbooks/
COPY packages/policy/package.json packages/policy/
COPY packages/signal/package.json packages/signal/
COPY packages/untrusted/package.json packages/untrusted/
COPY apps/server/package.json apps/server/
COPY apps/edge/package.json apps/edge/
COPY apps/bots/package.json apps/bots/
COPY apps/web/package.json apps/web/
COPY apps/indexer/package.json apps/indexer/
COPY apps/engines/package.json apps/engines/
COPY apps/mcp/package.json apps/mcp/
COPY apps/og-renderer/package.json apps/og-renderer/
COPY apps/landing/package.json apps/landing/
COPY contracts/package.json contracts/

# Browser bundles build on their own; only their dist folders reach the runtime image.
FROM base AS frontend
RUN pnpm install --frozen-lockfile --filter . --filter '@eko/web...' --filter '@eko/landing...'
COPY packages/shared packages/shared
COPY packages/untrusted packages/untrusted
COPY packages/receipts-verifier packages/receipts-verifier
COPY apps/web apps/web
COPY apps/landing apps/landing
RUN pnpm --filter @eko/web build && pnpm --filter @eko/landing build

# The edge runs its TypeScript through tsx: only the packages it imports are copied in.
FROM base AS edge
RUN pnpm install --frozen-lockfile --prod --filter '@eko/edge...'
COPY packages/shared packages/shared
COPY packages/chain packages/chain
COPY packages/db packages/db
COPY packages/playbooks packages/playbooks
COPY packages/policy packages/policy
COPY packages/untrusted packages/untrusted
COPY apps/edge apps/edge

FROM edge AS runtime
ENV NODE_ENV=production \
    PORT=8080 \
    WEB_DIST=/repo/web \
    LANDING_DIST=/repo/landing \
    RPC_USAGE_DIR=/tmp/eko-rpc-usage
COPY --from=frontend /repo/apps/web/dist /repo/web
COPY --from=frontend /repo/apps/landing/dist /repo/landing
RUN rm -rf /repo/web/assets/*.map /repo/landing/assets/*.map && chown -R node:node /repo/apps/edge
USER node
WORKDIR /repo/apps/edge
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "--import", "tsx", "src/main.ts"]
